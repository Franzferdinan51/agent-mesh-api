# Agent Mesh API — example environment
# Copy to .env and adjust:  cp .env.example .env
# Node 24 can load it without a dotenv dependency:
#   node --env-file=.env server.js
#
# SECURITY: AGENT_MESH_API_KEY below is the built-in DEV key
# (openclaw-mesh-default-key). It is public knowledge — anyone can read it
# in this repo. You MUST change it for any real deployment, and use the
# same value on the server and every client.

# ── Server (server.js) ─────────────────────────────────────────────
# Port the mesh server listens on.
PORT=4000
# Shared API key required on all /api routes (X-API-Key header).
AGENT_MESH_API_KEY=openclaw-mesh-default-key
# SQLite database path (default: agent-mesh.db next to server.js).
AGENT_MESH_DB_PATH=./agent-mesh.db
# Max JSON request body size.
AGENT_MESH_BODY_LIMIT=12mb
# Minutes since last seen before an agent counts as offline.
AGENT_MESH_OFFLINE_MINUTES=5
# Default per-message timeout (ms) and how often timeouts are checked (ms).
MESSAGE_TIMEOUT=300000
MESSAGE_TIMEOUT_CHECK_INTERVAL_MS=60000
# How often the scheduled-message delivery loop runs (ms).
SCHEDULED_MESSAGE_CHECK_INTERVAL_MS=15000

# ── Clients ────────────────────────────────────────────────────────
# Mesh server base URL for the auto-update client (auto-update-client.js).
MESH_URL=http://localhost:4000
# Mesh server base URL used by tools.js / utils/mesh-client.js.
AGENT_MESH_URL=http://localhost:4000
# WebSocket URL for websocket-client.js (also set by start-client.sh).
AGENT_MESH_WS_URL=ws://localhost:4000/ws
# This agent's name (required by auto-update-client.js) and the name
# start-client.sh registers under.
AGENT_NAME=MyAgent
AGENT_MESH_NAME=MyAgent
# This agent's own endpoint URL, advertised to the mesh on registration.
AGENT_ENDPOINT=http://localhost:3000
# This agent's version, reported in update acknowledgments.
AGENT_VERSION=1.0.0
# Where auto-update-client.js stages downloaded update payloads
# (default: ./updates next to auto-update-client.js). Payloads are
# staged only — never executed automatically.
AGENT_MESH_UPDATES_DIR=./updates
